
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="#090909">
    <title>Mis Clips TikTok PRO</title>

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            padding: 20px;
            background: #090909;
            color: white;
            font-family: Arial, sans-serif;
        }

        .app {
            max-width: 550px;
            margin: auto;
        }

        header {
            text-align: center;
            padding: 25px 10px;
        }

        header h1 {
            color: #ff0050;
            font-size: 30px;
        }

        header p {
            color: #aaa;
        }

        .panel {
            background: #191919;
            border: 1px solid #333;
            border-radius: 15px;
            padding: 20px;
            margin-bottom: 18px;
        }

        h2 {
            font-size: 19px;
            margin-top: 0;
        }

        label {
            display: block;
            margin-top: 16px;
            margin-bottom: 8px;
            color: #ddd;
        }

        input, select {
            width: 100%;
            padding: 14px;
            background: #292929;
            border: 1px solid #444;
            border-radius: 9px;
            color: white;
            font-size: 15px;
        }

        button {
            width: 100%;
            padding: 15px;
            margin-top: 18px;
            border: none;
            border-radius: 9px;
            background: #ff0050;
            color: white;
            font-size: 16px;
            font-weight: bold;
        }

        .secondary {
            background: #333;
        }

        #mensaje {
            color: #00d68f;
            text-align: center;
            margin-top: 15px;
        }

        footer {
            text-align: center;
            color: #777;
            padding: 20px;
            font-size: 12px;
        }
    </style>
</head>

<body>

<div class="app">

    <header>
        <h1>MIS CLIPS TIKTOK PRO</h1>
        <p>Tu estudio personal de creación de clips</p>
    </header>

    <section class="panel">
        <h2>🎬 Crear clips de YouTube</h2>

        <label>Enlace del video o directo</label>
        <input
            type="url"
            id="youtube"
            placeholder="Pega tu enlace de YouTube"
        >

        <label>Duración del clip</label>
        <select id="duracion">
            <option value="15">15 segundos</option>
            <option value="30">30 segundos</option>
            <option value="60">1 minuto</option>
            <option value="180">3 minutos</option>
            <option value="300">5 minutos</option>
            <option value="600">10 minutos</option>
        </select>

        <label>Formato del video</label>
        <select id="formato">
            <option value="9:16">Vertical TikTok 9:16</option>
            <option value="16:9">Horizontal YouTube 16:9</option>
            <option value="1:1">Cuadrado 1:1</option>
        </select>

        <label>Título del clip</label>
        <input
            type="text"
            id="titulo"
            placeholder="Título del video"
        >

        <button onclick="crearClip()">
            CREAR MI CLIP
        </button>

        <p id="mensaje"></p>
    </section>

    <section class="panel">
        <h2>📱 Publicación</h2>

        <label>Modalidad de publicación</label>
        <select id="publicacion">
            <option value="manual">Descargar y publicar manualmente</option>
            <option value="automatico">Preparar publicación automática</option>
        </select>

        <button class="secondary" onclick="alert('Módulo de publicación pendiente de conexión.')">
            CONFIGURAR TIKTOK
        </button>
    </section>

    <section class="panel">
        <h2>📂 Mis proyectos</h2>
        <p>Tu espacio personal para organizar tus clips.</p>
        <button class="secondary" onclick="alert('El almacenamiento se conectará en la siguiente etapa.')">
            VER MIS CLIPS
        </button>
    </section>

    <footer>
        MIS CLIPS TIKTOK PRO © 2026
    </footer>

</div>

<script>
function crearClip() {
    const enlace = document.getElementById("youtube").value.trim();
    const duracion = document.getElementById("duracion").value;
    const formato = document.getElementById("formato").value;
    const titulo = document.getElementById("titulo").value.trim();
    const mensaje = document.getElementById("mensaje");

    if (!enlace) {
        mensaje.innerText = "Debes introducir un enlace de YouTube.";
        return;
    }

    if (!/^https?:\/\/(www\.)?(youtube\.com|youtu\.be)\//i.test(enlace)) {
        mensaje.innerText = "Introduce un enlace válido de YouTube.";
        return;
    }

    mensaje.innerText =
        "Solicitud preparada. El motor de edición todavía no está conectado.";
}
</script>

</body>
</html>
